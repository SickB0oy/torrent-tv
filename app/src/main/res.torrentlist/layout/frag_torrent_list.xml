<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
							xmlns:tools="http://schemas.android.com/tools"
							android:layout_width="fill_parent"
							android:layout_height="fill_parent"
							android:orientation="vertical"
							tools:showIn="@layout/activity_torrent_view"
							tools:context="com.biglybt.android.client.fragment.TorrentListFragment">

	<!-- Torrent TV: "control from my phone" button, opens the QR code with address and password -->
	<TextView
		android:id="@+id/plus_remote_banner"
		android:nextFocusDown="@id/plus_service_stop"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:background="@drawable/plus_remote_banner_bg"
		android:clickable="true"
		android:focusable="true"
		android:paddingStart="16dp"
		android:paddingTop="14dp"
		android:paddingEnd="16dp"
		android:paddingBottom="14dp"
		android:gravity="center"
		android:textColor="#FFFFFFFF"
		android:textSize="16sp"
		android:textStyle="bold"
		android:visibility="gone"
		tools:text="Piloter depuis mon téléphone ou mon PC"
		tools:visibility="visible"/>

	<!-- Torrent TV: shown while the phone may put the app to sleep -->
	<TextView
		android:id="@+id/plus_battery_hint"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginStart="12dp"
		android:layout_marginTop="8dp"
		android:layout_marginEnd="12dp"
		android:background="@drawable/plus_battery_hint_bg"
		android:focusable="true"
		android:padding="12dp"
		android:text="@string/plus_battery_hint"
		android:textColor="#FF3A2600"
		android:textSize="14sp"
		android:visibility="gone"
		tools:visibility="visible"/>

	<!-- Torrent TV: stops the torrent service (red); the stopped screen has the
	     green button that starts it again -->
	<com.google.android.material.button.MaterialButton
		android:id="@+id/plus_service_stop"
		xmlns:app="http://schemas.android.com/apk/res-auto"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginStart="12dp"
		android:layout_marginTop="8dp"
		android:layout_marginEnd="12dp"
		android:layout_marginBottom="4dp"
		android:minHeight="52dp"
		android:nextFocusUp="@id/plus_remote_banner"
		android:text="@string/service_stop"
		android:textAllCaps="false"
		android:textColor="#FFFFFFFF"
		android:textSize="16sp"
		android:visibility="gone"
		app:backgroundTint="@color/service_red"
		app:cornerRadius="14dp"
		app:icon="@drawable/ic_power"
		app:iconGravity="textStart"
		app:iconTint="#FFFFFFFF"
		tools:visibility="visible"/>

	<!-- Torrent TV: filters, always visible (replaces the side menu) -->
	<HorizontalScrollView
		android:id="@+id/plus_filters_scroll"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:paddingStart="12dp"
		android:paddingEnd="12dp"
		android:scrollbars="none"
		android:visibility="gone"
		tools:visibility="visible">

		<com.google.android.material.chip.ChipGroup
			xmlns:app="http://schemas.android.com/apk/res-auto"
			android:id="@+id/plus_filters"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			app:chipSpacingHorizontal="8dp"
			app:selectionRequired="true"
			app:singleLine="true"
			app:singleSelection="true">

			<com.google.android.material.chip.Chip
				android:id="@+id/plus_filter_all"
				style="@style/Widget.MaterialComponents.Chip.Choice"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:checked="true"
				android:text="@string/plus_filter_all"/>

			<com.google.android.material.chip.Chip
				android:id="@+id/plus_filter_active"
				style="@style/Widget.MaterialComponents.Chip.Choice"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/plus_filter_active"/>

			<com.google.android.material.chip.Chip
				android:id="@+id/plus_filter_done"
				style="@style/Widget.MaterialComponents.Chip.Choice"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/plus_filter_done"/>

			<com.google.android.material.chip.Chip
				android:id="@+id/plus_filter_paused"
				style="@style/Widget.MaterialComponents.Chip.Choice"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/plus_filter_paused"/>
		</com.google.android.material.chip.ChipGroup>
	</HorizontalScrollView>
	<FrameLayout
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1"
		android:animateLayoutChanges="true">

		<include layout="@layout/incl_horizontal_progress"/>

		<!--
		Setting listSelector to #00000000 kills the state_pressed animation.
		@null does not work. The row's drawable will handle state colors
		-->
		<com.biglybt.android.widget.SwipeRefreshLayoutExtra
			android:id="@+id/swipe_container"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:animateLayoutChanges="true">

			<com.biglybt.android.adapter.FlexibleRecyclerView
				android:id="@+id/listTorrents"
				android:focusedByDefault="true"
				android:layout_width="fill_parent"
				android:layout_height="fill_parent"
				android:fastScrollEnabled="true"
				android:focusable="true"
				android:inAnimation="@android:anim/fade_in"
				android:listSelector="#00ffffff"
				android:outAnimation="@android:anim/fade_out"
				tools:listitem="@layout/row_torrent_list"/>
		</com.biglybt.android.widget.SwipeRefreshLayoutExtra>

		<include
			layout="@layout/incl_list_firstload"
			android:inAnimation="@android:anim/fade_in"
			android:outAnimation="@android:anim/fade_out"
			android:visibility="gone"
			tools:visibility="gone"/>

		<include
			layout="@layout/incl_empty_list"
			android:inAnimation="@android:anim/fade_in"
			android:outAnimation="@android:anim/fade_out"
			android:visibility="gone"
			tools:visibility="gone"/>
	</FrameLayout>
</LinearLayout>