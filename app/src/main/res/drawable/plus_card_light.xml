<?xml version="1.0" encoding="utf-8"?>
<!-- Torrent TV: torrent card, same look as the cards of the remote web page -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
	<item android:state_focused="true">
		<shape><corners android:radius="18dp" /><solid android:color="#FFECEEFF" /><stroke android:width="3dp" android:color="#FF4F5BEF" /></shape>
	</item>
	<item android:state_activated="true">
		<shape><corners android:radius="18dp" /><solid android:color="#FFECEEFF" /><stroke android:width="2dp" android:color="#FF8A93F7" /></shape>
	</item>
	<item android:state_pressed="true">
		<shape><corners android:radius="18dp" /><solid android:color="#FFF3F4FB" /><stroke android:width="1dp" android:color="#FFE3E5F2" /></shape>
	</item>
	<item>
		<shape><corners android:radius="18dp" /><solid android:color="#FFFFFFFF" /><stroke android:width="1dp" android:color="#FFE3E5F2" /></shape>
	</item>
</selector>
