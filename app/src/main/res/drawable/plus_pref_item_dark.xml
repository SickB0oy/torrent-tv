<?xml version="1.0" encoding="utf-8"?>
<!-- Torrent TV: setting card; the one the TV remote is on stands out -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
	<item android:state_focused="true">
		<shape><corners android:radius="14dp" /><solid android:color="#FF2E3366" /><stroke android:width="2dp" android:color="#FF9AA2FF" /></shape>
	</item>
	<item android:state_pressed="true">
		<shape><corners android:radius="14dp" /><solid android:color="#FF262A55" /></shape>
	</item>
	<item>
		<shape><corners android:radius="14dp" /><solid android:color="#14FFFFFF" /></shape>
	</item>
</selector>
