<?xml version="1.0" encoding="utf-8"?>
<!-- Torrent TV: switch track, blue when on, grey when off -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
	<item android:state_checked="true">
		<shape><corners android:radius="15dp" /><size android:width="52dp" android:height="30dp" /><solid android:color="#FF4F5BEF" /></shape>
	</item>
	<item>
		<shape><corners android:radius="15dp" /><size android:width="52dp" android:height="30dp" /><solid android:color="#FF6B6F8C" /></shape>
	</item>
</selector>
