<?xml version="1.0" encoding="utf-8"?>
<!-- Torrent TV: media library, a grid of posters -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/library_bg"
	android:orientation="vertical">

	<LinearLayout
		android:id="@+id/library_header"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:background="@drawable/library_header_bg"
		android:gravity="center_vertical"
		android:orientation="horizontal"
		android:paddingStart="8dp"
		android:paddingTop="10dp"
		android:paddingEnd="8dp"
		android:paddingBottom="10dp">

		<ImageButton
			android:id="@+id/library_back"
			style="@style/PlayerButton"
			android:contentDescription="@string/player_back"
			android:src="@drawable/ic_player_back" />

		<LinearLayout
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_marginStart="8dp"
			android:layout_weight="1"
			android:orientation="vertical">

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/library_title"
				android:textColor="#FFFFFFFF"
				android:textSize="20sp"
				android:textStyle="bold" />

			<TextView
				android:id="@+id/library_status"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:textColor="#CCFFFFFF"
				android:textSize="13sp" />
		</LinearLayout>

		<TextView
			android:id="@+id/library_downloads"
			android:layout_width="wrap_content"
			android:layout_height="40dp"
			android:layout_marginEnd="6dp"
			android:background="@drawable/library_pill_bg"
			android:clickable="true"
			android:focusable="true"
			android:gravity="center"
			android:paddingStart="14dp"
			android:paddingEnd="14dp"
			android:text="@string/library_downloads"
			android:textColor="#FFFFFFFF"
			android:textSize="14sp"
			android:textStyle="bold"
			android:drawablePadding="6dp"
			android:drawableStart="@drawable/ic_library_downloads" />

		<ProgressBar
			android:id="@+id/library_progress"
			style="?android:attr/progressBarStyleSmall"
			android:layout_width="24dp"
			android:layout_height="24dp"
			android:layout_marginEnd="8dp"
			android:indeterminateTint="#FFFFFFFF"
			android:visibility="gone" />

		<ImageButton
			android:id="@+id/library_refresh"
			style="@style/PlayerButton"
			android:contentDescription="@string/library_refresh"
			android:src="@drawable/ic_refresh_white_24dp" />

		<ImageButton
			android:id="@+id/library_key"
			style="@style/PlayerButton"
			android:contentDescription="@string/library_key_title"
			android:src="@drawable/ic_library_key" />
	</LinearLayout>

	<LinearLayout
		android:id="@+id/library_empty"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:gravity="center_horizontal"
		android:orientation="vertical"
		android:padding="20dp"
		android:visibility="gone">

		<TextView
			android:id="@+id/library_empty_text"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:maxWidth="560dp"
			android:textColor="@color/library_text"
			android:textColorLink="@color/library_accent"
			android:textSize="15sp" />

		<Button
			android:id="@+id/library_empty_action"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="12dp"
			android:visibility="gone" />
	</LinearLayout>

	<androidx.recyclerview.widget.RecyclerView
		android:id="@+id/library_grid"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1"
		android:clipToPadding="false"
		android:padding="10dp" />

	<TextView
		android:id="@+id/library_credit"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:gravity="center"
		android:paddingStart="16dp"
		android:paddingTop="6dp"
		android:paddingEnd="16dp"
		android:paddingBottom="8dp"
		android:textColor="@color/library_muted"
		android:textColorLink="@color/library_muted"
		android:textSize="11sp" />
</LinearLayout>
